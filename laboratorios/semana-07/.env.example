# ---------------------------------------------------------------------
# Plantilla de configuración. Cópiala como .env y pon tus valores:
#     cp .env.example .env
# El archivo .env NO se sube a GitHub (está en .gitignore).
# ---------------------------------------------------------------------

# Identificador de tu cuenta de Snowflake, con formato ORGNAME-ACCOUNTNAME.
# Lo obtienes en Snowsight con:
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=TU_ORG-TU_CUENTA

# Objetos creados por infra/snowflake/00_bootstrap_admin.sql
SNOWFLAKE_USER=NYC_TAXI_SVC
SNOWFLAKE_ROLE=NYC_TAXI_ROLE
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_DATABASE=NYC_TAXI
